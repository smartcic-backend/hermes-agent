# 日報 skill 需要的機密與連線設定，填入 $HERMES_HOME/.env（本專案為 .hermes-data/.env）。
# 這個檔案只列欄位名稱，不要把實際值 commit 進來。
# 例：hermes config set NOTION_TOKEN <值>

# Notion integration token（需能讀寫「應交日報名單」與「日報」資料庫）
NOTION_TOKEN=

# MessageCenter API token（api_token_apitokenmanager）
# 產生：cd MessageCenter && poetry run python manage.py report_token --action create --exp YYYY-MM-DD
MC_API_KEY=

# MessageCenter 的 MCP 端點（必須以 ASGI 啟動，/mcp 才存在）
#   本機原生執行 Hermes：http://localhost:8000/mcp
#   Hermes 跑在 Docker： http://host.docker.internal:8000/mcp
#   遠端主機：           https://<MC_HOST>:<port>/mcp
MC_MCP_URL=

# Notion 資料庫 id（必填）：資料庫網址 notion.so/<workspace>/<這 32 碼>?v=...
NOTION_DAILY_REPORT_DATABASE_ID=
NOTION_ROSTER_DATABASE_ID=
